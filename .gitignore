# ============================================================
#  Hybrid AI Text Detector - Git Ignore Specification
# ============================================================

# ── Virtual environments ────────────────────────────────────
.venv/
venv/
ENV/
env/

# ── Python cache & build artifacts ──────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ── Secrets & Environment files ─────────────────────────────
.env
.env.*

# ── IDE & Editor configuration ──────────────────────────────
.vscode/
.idea/
.ipynb_checkpoints/
*.swp
*.swo
*~

# ── Operating System files ──────────────────────────────────
.DS_Store
Thumbs.db

# ── Logs & Debugging ────────────────────────────────────────
logs/
*.log

# ── Documents, Manuscripts & Reports ────────────────────────
*.md
*.markdown
*.doc
*.docx
*.docm
*.rtf
*.pdf
!README.md

# ── Backup & Corrupted files ────────────────────────────────
*.bak
*.corrupted_bak
*.meta_bak
.git_old_backup/

# ── Temporary scratch files & scripts ───────────────────────
temp.py
scratch_audit.py
fix.py
b64.txt
output.md
scratch/
tmp_profile/

# ── Datasets ────────────────────────────────────────────────
Datasets/
datasets/

# ── Large Model Weights (Exceed GitHub 100MB Limit) ─────────
*.pt
*.pth
*.bin
*.safetensors
*.ckpt

# ── Training/Split Artifacts & Intermediate Checkpoints ─────
outputs/v2_1_splits/
outputs/v3_splits/
outputs/test_phase8641_save/
outputs/handcrafted/
outputs/labels/
outputs/tfidf/*.npz
outputs/retraining_v2/test_run_fp32/
outputs/generalization_phase1/
outputs/phase2_acquisition/
outputs/phase2_evaluation/
outputs/phase3_evidence/
outputs/phase3_manuscript/
outputs/phase3c_model_improvement/
**/checkpoint-*/
checkpoint-*/
models/feature_engineering/
reports/

# ── Training/Kaggle Scripts Not Required by app.py ──────────
balance_and_split_v3.py
create_v3_splits.py
generate_manuscript.py
outputs/kaggle_notebooks/kaggle_*_v3*.py

# ── Model Checkpoints (Allow specific runtime models) ───────
outputs/*/checkpoints/
!outputs/ensemble/checkpoints/
!outputs/ensemble/checkpoints/*.joblib
!outputs/ensemble/checkpoints/*.json
