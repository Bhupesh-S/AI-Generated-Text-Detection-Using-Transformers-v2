# ============================================================
#  Hybrid AI Text Detector - Git Ignore Specification
# ============================================================
.git_old_backup/
# ── Virtual environments ─────────────────────────────────────
.venv/
venv/
ENV/
env/

# ── Python cache & build artifacts ───────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ── Secrets & Environment files ──────────────────────────────
.env
.env.*

# ── IDE & Editor configuration ───────────────────────────────
.vscode/
.idea/
.ipynb_checkpoints/
*.swp
*.swo
*~

# ── Operating System files ───────────────────────────────────
.DS_Store
Thumbs.db

# ── Logs & Debugging ─────────────────────────────────────────
logs/
*.log

# ── Reports & Generated PDFs ──────────────────────────────────
*.pdf

# ── Large Model Files & Weights ───────────────────────────────
*.pt
*.pth
*.bin
*.safetensors
*.ckpt

# ── Training Checkpoints & Profiling ──────────────────────────
outputs/*/checkpoints/
outputs/retraining_v2_1/*/checkpoint-*/
outputs/**/checkpoint-*/
tmp_profile/
scratch/

# ── Datasets ─────────────────────────────────────────────────
Datasets/

# ── Generated Dataset & Feature Artifacts ─────────────────────
outputs/v2_1_splits/
outputs/handcrafted/
outputs/labels/
models/feature_engineering/

# ── Large TF-IDF Artifacts ────────────────────────────────────
outputs/tfidf/*.npz
